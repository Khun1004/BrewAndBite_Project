<?xml version="1.0" encoding="utf-8"?>
<!--
    🧾 주문 상세 화면 (OrderDetailActivity) — Order 탭 주문 내역 카드의 > 를 누르면 열림
    헤더: [<] 뒤로 · MY ORDERS / 주문 상세
    ① 상태 카드: [배달 완료] · 날짜 · 주문번호 · 배달/포장 (진행 중이면 남은 시간 + 진행 바)
    ② 주문한 메뉴: 메뉴마다 [✏️ 리뷰 쓰기]
    ③ 결제 정보: 주문 금액 · 배달비 · 쿠폰 할인 · 총 결제
    [🛒 같은 메뉴 다시 담기]
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_cream"
    tools:context=".order.OrderDetailActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:elevation="4dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:scaleX="1.6"
            android:scaleY="1.6"
            android:src="@drawable/bg_header_rings"
            android:translationX="70dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_header_button"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/bb_cream" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="50dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.25"
                android:text="@string/header_order_eyebrow"
                android:textColor="@color/bb_nav_active"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_receipt"
                    app:tint="@color/bb_nav_active" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/order_detail_title"
                    android:textColor="@color/bb_cream"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBox">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ① 상태 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_order_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textStatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_notice_type"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:backgroundTint="@color/bb_open_bg"
                        tools:text="배달 완료"
                        tools:textColor="@color/bb_open" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/textMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/bb_brown"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="🛵 배달" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/bb_espresso"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="배달이 완료되었어요 🎉" />

                <TextView
                    android:id="@+id/textEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/bb_brown"
                    android:textSize="13sp"
                    tools:text="오후 3:45 도착 완료" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressOrder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="1000"
                    app:indicatorColor="@color/bb_brown"
                    app:trackColor="@color/bb_divider"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="6dp"
                    tools:progress="1000" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/bb_divider" />

                <!-- 주문 일시 · 주문번호 -->
                <TextView
                    android:id="@+id/textInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/bb_muted"
                    android:textSize="13sp"
                    tools:text="주문 일시   10.26 (월) 오후 3:12\n주문 번호   BB-20261026-4821" />
            </LinearLayout>

            <!-- ② 주문한 메뉴 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_order_card"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/textMenuTitle"
                    style="@style/MenuOptionTitle"
                    tools:text="주문한 메뉴 3개" />

                <LinearLayout
                    android:id="@+id/lineList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/textReviewHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_coupon_dday"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/bb_brown"
                    android:textSize="12sp"
                    tools:text="⭐ 맛있게 드셨나요? 메뉴 옆 [리뷰 쓰기]를 눌러 별점을 남겨 주세요" />
            </LinearLayout>

            <!-- ③ 결제 정보 -->
            <LinearLayout
                android:id="@+id/payBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_order_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/MenuOptionTitle"
                    android:layout_marginBottom="6dp"
                    android:text="@string/order_detail_pay_title" />

                <!-- 금액 줄은 코드에서 넣음 (주문 금액 · 배달비 · 쿠폰 할인) -->
                <LinearLayout
                    android:id="@+id/payRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/bb_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/order_detail_total"
                        android:textColor="@color/bb_espresso"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/bb_brown"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="15,000원" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonReorder"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/bb_espresso"
                android:text="@string/order_reorder"
                android:textColor="@color/bb_nav_active"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>