<?xml version="1.0" encoding="utf-8"?>
<!-- Cart 탭 화면 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cartRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_cream"
    tools:context=".cart.CartFragment">

    <!-- 공통 헤더 (Cart / Store / Order / My Page 동일) -->
    <include
        android:id="@+id/pageHeader"
        layout="@layout/layout_page_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 헤더 아래 줄: 담은 메뉴 수 + 전체 삭제 -->
    <LinearLayout
        android:id="@+id/cartToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pageHeader">

        <TextView
            android:id="@+id/textItemCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/bb_espresso"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="담은 메뉴 3개" />

        <TextView
            android:id="@+id/textClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="@string/cart_clear"
            android:textColor="@color/bb_brown"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 담은 메뉴 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/summaryBox"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cartToolbar"
        tools:itemCount="3"
        tools:listitem="@layout/item_cart" />

    <!-- 비어 있을 때 -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pageHeader">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_icon_circle"
            android:importantForAccessibility="no"
            android:padding="22dp"
            android:src="@drawable/ic_cart"
            app:tint="@color/bb_brown" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cart_empty"
            android:textColor="@color/bb_espresso"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cart_empty_desc"
            android:textColor="@color/bb_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGoMenu"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/bb_brown"
            android:paddingHorizontal="28dp"
            android:text="@string/cart_go_menu"
            android:textColor="@color/white"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- 아래쪽 결제 금액 -->
    <!-- 아래쪽: 수령 방법 + 결제 금액 -->
    <LinearLayout
        android:id="@+id/summaryBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_summary"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 배달 / 포장 선택 -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleFulfillment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDelivery"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="@drawable/bb_toggle_bg"
                android:text="@string/cart_mode_delivery"
                android:textColor="@drawable/bb_toggle_text"
                app:strokeColor="@color/bb_brown" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPickup"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="@drawable/bb_toggle_bg"
                android:text="@string/cart_mode_pickup"
                android:textColor="@drawable/bb_toggle_text"
                app:strokeColor="@color/bb_brown" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 총 수량 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cart_total_count_label"
                android:textColor="@color/bb_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textTotalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bb_espresso"
                android:textSize="14sp"
                tools:text="5개" />
        </LinearLayout>

        <!-- 주문 금액 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cart_subtotal_label"
                android:textColor="@color/bb_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textSubtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bb_espresso"
                android:textSize="14sp"
                tools:text="24,500원" />
        </LinearLayout>

        <!-- 배달비 (포장이면 숨김) -->
        <LinearLayout
            android:id="@+id/rowDeliveryFee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cart_delivery_fee_label"
                android:textColor="@color/bb_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textDeliveryFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bb_espresso"
                android:textSize="14sp"
                tools:text="1,000원" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/bb_divider" />

        <!-- 총 결제 금액 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cart_total_price_label"
                android:textColor="@color/bb_espresso"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bb_brown"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="25,500원" />
        </LinearLayout>

        <!-- 최소 주문 금액 안내 (달성하면 숨김) -->
        <TextView
            android:id="@+id/textMinOrderHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/bb_brown"
            android:textSize="13sp"
            tools:text="최소 주문 금액 14,000원 · 3,500원 더 담아주세요" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOrder"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@drawable/bb_pay_bg"
            android:textColor="@drawable/bb_pay_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            tools:text="25,500원 결제하기" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>