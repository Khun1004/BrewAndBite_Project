<?xml version="1.0" encoding="utf-8"?>
<!--
    알림 카드 (NoticeAdapter)
    [색 동그라미 아이콘]  [쿠폰] · 3분 전          ●
                        가입 축하 쿠폰이 도착했어요
                        10,000원 이상 주문하면 2,000원 할인돼요…
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/bb_nav_active"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- 종류별 색 동그라미 아이콘 -->
        <ImageView
            android:id="@+id/imageIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_icon_circle"
            android:importantForAccessibility="no"
            android:padding="12dp"
            tools:backgroundTint="@color/bb_nav_active"
            tools:src="@drawable/ic_coupon"
            tools:tint="@color/bb_espresso" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- [쿠폰] · 3분 전 · ● -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_notice_type"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:backgroundTint="@color/bb_nav_active"
                    tools:text="쿠폰"
                    tools:textColor="@color/bb_espresso" />

                <TextView
                    android:id="@+id/textTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="@color/bb_muted"
                    android:textSize="11sp"
                    tools:text="3분 전" />

                <View
                    android:id="@+id/dotUnread"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_unread_dot" />
            </LinearLayout>

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/bb_espresso"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="가입 축하 쿠폰이 도착했어요 🎟" />

            <TextView
                android:id="@+id/textBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/bb_brown"
                android:textSize="13sp"
                tools:text="10,000원 이상 주문하면 2,000원 할인돼요. 30일 동안 쓸 수 있어요." />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>