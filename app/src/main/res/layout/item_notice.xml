<?xml version="1.0" encoding="utf-8"?>
<!-- 알림 한 줄: [아이콘] 제목 / 내용 / 3분 전  · 안 읽었으면 빨간 점 + 베이지 바탕 (NoticeAdapter) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp"
        tools:background="@color/bb_beige_light">

        <ImageView
            android:id="@+id/imageIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_circle"
            android:importantForAccessibility="no"
            android:padding="10dp"
            app:tint="@color/bb_brown"
            tools:src="@drawable/ic_coupon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/bb_espresso"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="가입 축하 쿠폰이 도착했어요 🎟" />

                <View
                    android:id="@+id/dotUnread"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_unread_dot" />
            </LinearLayout>

            <TextView
                android:id="@+id/textBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/bb_brown"
                android:textSize="13sp"
                tools:text="10,000원 이상 주문하면 2,000원 할인돼요. 30일 동안 쓸 수 있어요." />

            <TextView
                android:id="@+id/textTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/bb_muted"
                android:textSize="11sp"
                tools:text="3분 전" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="74dp"
        android:background="@color/bb_divider" />
</LinearLayout>