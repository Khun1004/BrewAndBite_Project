<?xml version="1.0" encoding="utf-8"?>
<!-- Order 탭 화면 (헤더 아래는 빈 화면 · 팀원 작업 공간) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/orderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_cream"
    tools:context=".order.OrderFragment">

    <!-- 공통 헤더 (Cart / Store / Order / My Page 동일) -->
    <include
        android:id="@+id/pageHeader"
        layout="@layout/layout_page_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TODO (팀원): 헤더 아래에 Order 화면 내용을 작성하세요 -->
    <!-- 예) app:layout_constraintTop_toBottomOf="@+id/pageHeader" 로 헤더 아래에 붙이기 -->

</androidx.constraintlayout.widget.ConstraintLayout>