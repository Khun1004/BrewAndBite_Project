<?xml version="1.0" encoding="utf-8"?>
<!--
    장바구니 한 줄: 메뉴 이미지가 카드 위로 튀어나온 디자인.
    짝수 줄은 이미지가 왼쪽, 홀수 줄은 오른쪽 (CartAdapter에서 방향만 바꿈).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <!-- 흰 카드 (이미지보다 26dp 아래에서 시작) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/bb_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="96dp"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp">

            <!-- 이미지 자리 비워 두기 (이미지는 카드 밖에서 겹쳐 그림) -->
            <Space
                android:layout_width="96dp"
                android:layout_height="1dp"
                android:layout_marginEnd="14dp" />

            <!-- 글자 영역: 항상 왼쪽→오른쪽 순서 유지 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="ltr"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/bb_espresso"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Caffè Latte" />

                    <ImageView
                        android:id="@+id/buttonRemove"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cart_remove"
                        android:padding="5dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/bb_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textUnitPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bb_muted"
                    android:textSize="12sp"
                    tools:text="개당 5,000원" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textLineTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/bb_brown"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="10,000원" />

                    <!-- 수량 조절 [-  2  +] -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_qty"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <ImageView
                            android:id="@+id/buttonMinus"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_circle_button"
                            android:contentDescription="@string/cart_minus"
                            android:padding="6dp"
                            android:src="@drawable/ic_minus"
                            app:tint="@color/bb_espresso" />

                        <TextView
                            android:id="@+id/textQuantity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:minWidth="32dp"
                            android:textColor="@color/bb_espresso"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="2" />

                        <ImageView
                            android:id="@+id/buttonPlus"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_add_button"
                            android:contentDescription="@string/cart_plus"
                            android:padding="6dp"
                            android:src="@drawable/ic_add_white" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 메뉴 이미지: 카드 위로 튀어나옴 (진한 배경 + 접시 위 이모지) -->
    <FrameLayout
        android:id="@+id/imageBox"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_cart_image"
        android:elevation="8dp">

        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_plate">

            <TextView
                android:id="@+id/textEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="32sp"
                tools:text="☕" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>