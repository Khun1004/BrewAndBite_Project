<?xml version="1.0" encoding="utf-8"?>
<!--
    리뷰 한 개 = 카드 한 장 (손님 한 명마다 따로)
    (민) 민지 [내 리뷰] / ★★★★★ 2026.10.24 / [주문 옵션] / 📷 / 글 / (내 리뷰면) 수정 · 삭제
    내 리뷰는 살구색 테두리 (ReviewViews.bindReview)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardReview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_order_card"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:textColor="@color/bb_cream"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="쿤" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/bb_espresso"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="쿤산웨이" />

                <TextView
                    android:id="@+id/textMine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_default_tag"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="@string/review_mine"
                    android:textColor="@color/bb_nav_active"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/textDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/bb_muted"
                    android:textSize="11sp"
                    tools:text="2026.10.24" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 주문할 때 고른 옵션 (예: ICE · Large · 샷 +1) -->
    <TextView
        android:id="@+id/textOptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_coupon_dday"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/bb_brown"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="ICE · Large · 샷 +1"
        tools:visibility="visible" />

    <!-- 📷 리뷰 사진 (코드에서 채움) -->
    <LinearLayout
        android:id="@+id/photoRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textReview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/bb_espresso"
        android:textSize="14sp"
        tools:text="산미가 적당하고 고소해요! 다음에도 또 시킬게요." />

    <!-- 내 리뷰일 때만: 수정 · 삭제 -->
    <LinearLayout
        android:id="@+id/rowMine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/buttonEdit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="@string/review_edit"
            android:textColor="@color/bb_brown"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonDelete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="@string/my_delete"
            android:textColor="@color/bb_closed"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>