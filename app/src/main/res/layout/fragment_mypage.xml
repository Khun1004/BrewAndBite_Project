<?xml version="1.0" encoding="utf-8"?>
<!-- My Page 탭 화면 (준비 중) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mypageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_cream"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".mypage.MyPageFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👤"
        android:textSize="52sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/mypage_title"
        android:textColor="@color/bb_espresso"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/placeholder_desc"
        android:textColor="@color/bb_muted"
        android:textSize="13sp" />

</LinearLayout>