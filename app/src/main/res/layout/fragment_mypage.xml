<?xml version="1.0" encoding="utf-8"?>
<!-- My Page 탭: 로그인 전에는 로그인 안내, 로그인 후에는 프로필 + 펼치는 목록(내 정보·주소·결제 수단·주문 기록·찜) + 로그아웃 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mypageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_cream"
    tools:context=".mypage.MyPageFragment">

    <!-- 공통 헤더 (Cart / Store / Order / My Page 동일) -->
    <include
        android:id="@+id/pageHeader"
        layout="@layout/layout_page_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pageHeader">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="32dp">

            <!-- ── 로그인 전 ── -->
            <LinearLayout
                android:id="@+id/loggedOutView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="28dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_icon_circle"
                    android:gravity="center"
                    android:text="👋"
                    android:textSize="34sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/my_login_needed"
                    android:textColor="@color/bb_espresso"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/my_login_desc"
                    android:textColor="@color/bb_muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonLogin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/bb_espresso"
                    android:text="@string/my_login_button"
                    android:textColor="@color/bb_nav_active"
                    android:textStyle="bold"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <!-- ── 로그인 후 ── -->
            <LinearLayout
                android:id="@+id/loggedInView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 프로필 카드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_info_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textAvatar"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:textColor="@color/bb_cream"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="쿤" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/bb_espresso"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            tools:text="쿤산웨이" />

                        <TextView
                            android:id="@+id/textEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/bb_muted"
                            android:textSize="13sp"
                            tools:text="khun@example.com" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ── 👤 내 정보 ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_info_card"
                    android:orientation="vertical">

                    <!-- 왼쪽 아이콘 · 가운데 글 · 오른쪽 > (누르면 아래 내용이 펼쳐짐) -->
                    <LinearLayout
                        android:id="@+id/rowInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="68dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center"
                            android:text="👤"
                            android:textSize="19sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/my_section_info"
                                android:textColor="@color/bb_espresso"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textInfoSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/bb_muted"
                                android:textSize="12sp"
                                tools:text="010-1234-5678" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/chevronInfo"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/bb_muted" />
                    </LinearLayout>

                    <!-- 펼쳐지는 내용 -->
                    <LinearLayout
                        android:id="@+id/contentInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/bb_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:text="@string/my_label_name"
                                android:textColor="@color/bb_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textInfoName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/bb_espresso"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="쿤산웨이" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:text="@string/my_label_email"
                                android:textColor="@color/bb_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textInfoEmail"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/bb_espresso"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="khun@example.com" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:text="@string/my_label_phone"
                                android:textColor="@color/bb_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textInfoPhone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/bb_espresso"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="010-1234-5678" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonEditName"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/bb_beige_light"
                                android:text="@string/my_edit_name"
                                android:textColor="@color/bb_brown"
                                android:textStyle="bold"
                                app:cornerRadius="14dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonEditPhone"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:backgroundTint="@color/bb_beige_light"
                                android:text="@string/my_edit_phone"
                                android:textColor="@color/bb_brown"
                                android:textStyle="bold"
                                app:cornerRadius="14dp" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- ── 📍 배달 주소 ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_info_card"
                    android:orientation="vertical">

                    <!-- 왼쪽 아이콘 · 가운데 글 · 오른쪽 > (누르면 아래 내용이 펼쳐짐) -->
                    <LinearLayout
                        android:id="@+id/rowAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="68dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center"
                            android:text="📍"
                            android:textSize="19sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/my_section_address"
                                android:textColor="@color/bb_espresso"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textAddressSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/bb_muted"
                                android:textSize="12sp"
                                tools:text="대구광역시 북구 복현로 35 101호" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/chevronAddress"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/bb_muted" />
                    </LinearLayout>

                    <!-- 펼쳐지는 내용 -->
                    <LinearLayout
                        android:id="@+id/contentAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/bb_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:text="@string/my_label_address"
                                android:textColor="@color/bb_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textInfoAddress"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/bb_espresso"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="대구광역시 북구 복현로 35" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:text="@string/my_label_address_detail"
                                android:textColor="@color/bb_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textInfoAddressDetail"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/bb_espresso"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="101호" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonEditAddress"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="@color/bb_beige_light"
                            android:text="@string/my_search_address"
                            android:textColor="@color/bb_brown"
                            android:textStyle="bold"
                            app:cornerRadius="14dp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- ── 💳 결제 수단 ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_info_card"
                    android:orientation="vertical">

                    <!-- 왼쪽 아이콘 · 가운데 글 · 오른쪽 > (누르면 아래 내용이 펼쳐짐) -->
                    <LinearLayout
                        android:id="@+id/rowPayment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="68dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center"
                            android:text="💳"
                            android:textSize="19sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/my_section_payment"
                                android:textColor="@color/bb_espresso"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textPaymentSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/bb_muted"
                                android:textSize="12sp"
                                tools:text="1개 · 기본: 신한카드 •••• 1234" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/chevronPayment"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/bb_muted" />
                    </LinearLayout>

                    <!-- 펼쳐지는 내용 -->
                    <LinearLayout
                        android:id="@+id/contentPayment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/bb_divider" />

                        <TextView
                            android:id="@+id/textPaymentTip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/my_payment_tip"
                            android:textColor="@color/bb_muted"
                            android:textSize="11sp" />

                        <!-- 결제 수단 목록 (item_payment_method 를 코드에서 넣음) -->
                        <LinearLayout
                            android:id="@+id/paymentList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/textNoPayment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:paddingVertical="10dp"
                            android:text="@string/my_no_payment"
                            android:textColor="@color/bb_muted"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonAddPayment"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="@color/bb_beige_light"
                            android:text="@string/my_add_payment"
                            android:textColor="@color/bb_brown"
                            android:textStyle="bold"
                            app:cornerRadius="14dp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- ── 🧾 주문 기록 ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_info_card"
                    android:orientation="vertical">

                    <!-- 왼쪽 아이콘 · 가운데 글 · 오른쪽 > (누르면 아래 내용이 펼쳐짐) -->
                    <LinearLayout
                        android:id="@+id/rowOrders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="68dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center"
                            android:text="🧾"
                            android:textSize="19sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/my_section_orders"
                                android:textColor="@color/bb_espresso"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textOrdersSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/bb_muted"
                                android:textSize="12sp"
                                tools:text="0건" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/chevronOrders"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/bb_muted" />
                    </LinearLayout>

                    <!-- 펼쳐지는 내용 -->
                    <LinearLayout
                        android:id="@+id/contentOrders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/bb_divider" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:paddingVertical="10dp"
                            android:text="@string/my_orders_empty"
                            android:textColor="@color/bb_muted"
                            android:textSize="13sp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- ── ♡ 찜한 메뉴 ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_info_card"
                    android:orientation="vertical">

                    <!-- 왼쪽 아이콘 · 가운데 글 · 오른쪽 > (누르면 아래 내용이 펼쳐짐) -->
                    <LinearLayout
                        android:id="@+id/rowFavorites"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="68dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center"
                            android:text="♡"
                            android:textSize="19sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/my_section_favorites"
                                android:textColor="@color/bb_espresso"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textFavoritesSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/bb_muted"
                                android:textSize="12sp"
                                tools:text="곧 추가돼요" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/chevronFavorites"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/bb_muted" />
                    </LinearLayout>

                    <!-- 펼쳐지는 내용 -->
                    <LinearLayout
                        android:id="@+id/contentFavorites"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/bb_divider" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:paddingVertical="10dp"
                            android:text="@string/my_favorites_empty"
                            android:textColor="@color/bb_muted"
                            android:textSize="13sp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- ── 🔒 계정 보안 ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_info_card"
                    android:orientation="vertical">

                    <!-- 왼쪽 아이콘 · 가운데 글 · 오른쪽 > (누르면 아래 내용이 펼쳐짐) -->
                    <LinearLayout
                        android:id="@+id/rowSecurity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="68dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center"
                            android:text="🔒"
                            android:textSize="19sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/my_section_security"
                                android:textColor="@color/bb_espresso"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textSecuritySummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/bb_muted"
                                android:textSize="12sp"
                                tools:text="비밀번호 변경" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/chevronSecurity"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/bb_muted" />
                    </LinearLayout>

                    <!-- 펼쳐지는 내용 -->
                    <LinearLayout
                        android:id="@+id/contentSecurity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/bb_divider" />

                        <TextView
                            android:id="@+id/textSecurityDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/my_security_desc"
                            android:textColor="@color/bb_muted"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonChangePassword"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:backgroundTint="@color/bb_beige_light"
                            android:text="@string/my_change_password"
                            android:textColor="@color/bb_brown"
                            android:textStyle="bold"
                            app:cornerRadius="14dp" />

                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonLogout"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/my_logout"
                    android:textColor="@color/bb_brown"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/bb_beige" />
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>