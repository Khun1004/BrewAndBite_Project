<?xml version="1.0" encoding="utf-8"?>
<!--
    휴대폰 번호 + 인증번호 입력 묶음 (회원가입, My Page 번호 변경에서 같이 사용)
    [ 휴대폰 번호        ] [인증번호 받기]
    [ 인증번호 6자리      ] [확인]        ← 문자를 보내면 나타남
    ✓ 휴대폰 인증 완료                     ← 인증되면 나타남
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPhone"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/bb_brown"
            app:hintTextColor="@color/bb_brown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/phone_hint"
            app:placeholderText="010-1234-5678">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:maxLength="13"
                android:maxLines="1"
                android:textColor="@color/bb_espresso"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSendCode"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="5dp"
            android:backgroundTint="@color/bb_espresso"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="@string/phone_send"
            android:textColor="@color/bb_nav_active"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <!-- 인증번호 입력 (문자를 보내면 보임) -->
    <LinearLayout
        android:id="@+id/codeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCode"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/bb_brown"
            app:hintTextColor="@color/bb_brown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/phone_code_hint"
            app:helperTextTextColor="@color/bb_closed"
            app:counterEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:letterSpacing="0.3"
                android:maxLength="6"
                android:maxLines="1"
                android:textColor="@color/bb_espresso"
                android:textSize="16sp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonConfirmCode"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="5dp"
            android:backgroundTint="@color/bb_brown"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="88dp"
            android:text="@string/phone_confirm"
            android:textColor="@color/bb_cream"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <!-- 인증 완료 -->
    <TextView
        android:id="@+id/textVerified"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_verified_tag"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/phone_verified"
        android:textColor="@color/bb_open"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>