<?xml version="1.0" encoding="utf-8"?>
<!--
    🔍 메뉴 검색 화면 (SearchActivity) — 홈의 검색창 · 필터 버튼을 누르면 열림
    헤더: [<] [🔍 커피, 디저트, 음식 검색   ✕] [정렬]
    검색어가 없을 때: 최근 검색어 · 인기 검색어 · 카테고리로 찾기
    검색어가 있을 때: 결과 N개 · 카테고리 칩 · 정렬 · 메뉴 목록 (없으면 안내)
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_cream"
    tools:context=".search.SearchActivity">

    <!-- 헤더 -->
    <LinearLayout
        android:id="@+id/headerBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_header_button"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/back"
            app:tint="@color/bb_cream" />

        <!-- 검색창 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/bb_muted" />

            <EditText
                android:id="@+id/editSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/bb_espresso"
                android:textColorHint="@color/bb_muted"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/buttonClear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_clear"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/bb_muted" />
        </LinearLayout>

        <!-- 정렬 -->
        <TextView
            android:id="@+id/buttonSort"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_pill_glass"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:textColor="@color/bb_cream"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="추천순 ▾" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSearch"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBox">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── 검색어가 없을 때 ── -->
            <LinearLayout
                android:id="@+id/suggestBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 최근 검색어 -->
                <LinearLayout
                    android:id="@+id/recentBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/MenuOptionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/search_recent" />

                        <TextView
                            android:id="@+id/buttonClearRecent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="6dp"
                            android:text="@string/search_clear_all"
                            android:textColor="@color/bb_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsRecent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- 인기 검색어 -->
                <TextView
                    style="@style/MenuOptionTitle"
                    android:text="@string/search_popular" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsPopular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <!-- 카테고리로 찾기 -->
                <TextView
                    style="@style/MenuOptionTitle"
                    android:layout_marginTop="22dp"
                    android:text="@string/search_by_category" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- ── 검색어가 있을 때 ── -->
            <LinearLayout
                android:id="@+id/resultBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/textResultCount"
                    style="@style/MenuOptionTitle"
                    tools:text="'라떼' 검색 결과 4개" />

                <!-- 카테고리 필터: 전체 · 커피 · 음료 … (칩은 코드에서) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_menu" />

                <!-- 결과가 없을 때 -->
                <LinearLayout
                    android:id="@+id/emptyResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="36dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_icon_circle"
                        android:importantForAccessibility="no"
                        android:padding="22dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/bb_brown" />

                    <TextView
                        android:id="@+id/textEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textColor="@color/bb_espresso"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="'마라탕'에 맞는 메뉴가 없어요" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/search_empty_desc"
                        android:textColor="@color/bb_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>