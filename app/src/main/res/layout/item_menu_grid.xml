<?xml version="1.0" encoding="utf-8"?>
<!-- 메뉴 목록 화면의 2열 카드: 동그란 접시가 카드 위로 반쯤 걸쳐 있음 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="46dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/bb_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="58dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/textName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/bb_espresso"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Caramel Macchiato" />

            <TextView
                android:id="@+id/textDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:lines="2"
                android:textColor="@color/bb_muted"
                android:textSize="12sp"
                tools:text="우유 거품 위에 카라멜 소스를 듬뿍" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/bb_brown"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="5,800원" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:contentDescription="@null"
                            android:src="@drawable/star"
                            app:tint="#F2A93B" />

                        <TextView
                            android:id="@+id/textRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:textColor="@color/bb_muted"
                            android:textSize="11sp"
                            tools:text="4.8" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/buttonAdd"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_add_button"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:src="@drawable/ic_add_white" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 접시 (카드보다 나중에 그려져서 위에 보임) -->
    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_plate"
        android:elevation="2dp">

        <TextView
            android:id="@+id/textEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="44sp"
            tools:text="☕" />
    </FrameLayout>
</FrameLayout>