<?xml version="1.0" encoding="utf-8"?>
<!--
    내가 쓴 리뷰 1개 (My Page → 리뷰 내역)
    (🍝) Cream Pasta                         >   ← 누르면 메뉴 상세
    ★★★★★  2026.10.26
    [ICE · Large]
    산미가 적당하고 고소해요!
                                  [수정] [삭제]
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/bb_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 메뉴 (누르면 메뉴 상세) -->
        <LinearLayout
            android:id="@+id/rowMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textEmoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:textSize="20sp"
                tools:text="🍝" />

            <TextView
                android:id="@+id/textMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/bb_espresso"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Cream Pasta" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/bb_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/textDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/bb_muted"
                android:textSize="11sp"
                tools:text="2026.10.26" />
        </LinearLayout>

        <TextView
            android:id="@+id/textOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_coupon_dday"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/bb_brown"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="ICE · Large"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/bb_espresso"
            android:textSize="14sp"
            tools:text="산미가 적당하고 고소해요! 다음에도 또 시킬게요." />

        <!-- 수정 · 삭제 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEdit"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/my_review_edit"
                android:textColor="@color/bb_brown"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/bb_beige" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDelete"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/my_review_delete"
                android:textColor="@color/bb_closed"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/bb_closed_bg" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>