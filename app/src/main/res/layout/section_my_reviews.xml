<?xml version="1.0" encoding="utf-8"?>
<!-- My Page 상세 화면 내용 · ⭐ 리뷰 내역: 내가 쓴 리뷰 카드 (수정 · 삭제) / 없으면 안내 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textReviewCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/bb_muted"
        android:textSize="12sp"
        tools:text="내가 쓴 리뷰 3개 · 평균 ★4.7 · 최근에 쓴 순" />

    <LinearLayout
        android:id="@+id/reviewList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- 리뷰가 없을 때 -->
    <LinearLayout
        android:id="@+id/emptyReviews"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="20dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/bb_star" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/my_reviews_empty"
            android:textColor="@color/bb_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGoOrders"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/bb_espresso"
            android:paddingHorizontal="24dp"
            android:text="@string/my_reviews_go_orders"
            android:textColor="@color/bb_nav_active"
            android:textStyle="bold"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>