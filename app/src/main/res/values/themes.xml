<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.BrewAndBite" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/bb_brown</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/bb_beige</item>
        <item name="android:windowBackground">@color/bb_cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.BrewAndBite" parent="Base.Theme.BrewAndBite" />

    <!-- 원형 프로필 이미지 -->
    <style name="ShapeAppearance.BrewBite.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 스플래시 화면의 반투명 특징 칩 -->
    <style name="SplashChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill_glass</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/bb_cream</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 동그란 이미지 (프로필 사진) -->
    <style name="ShapeCircle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 메뉴 상세: 옵션 제목 -->
    <style name="MenuOptionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/bb_espresso</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 메뉴 상세: 고르는 옵션 칸 (선택 모양은 코드에서 바꿈) -->
    <style name="MenuOption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/bg_option</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/bb_espresso</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>